	Bge.s	.OkPR			Vérif antibug
	Clr.l	D2
.OkPR	Move.l	D2,(A2)+
	Bra.s	.LoopPR
.EndLPR	Move.w	DegradeMenuA,Prefs_DegradeMenuA(A1)	DEGRADES
	Move.w	DegradeMenuB,Prefs_DegradeMenuB(A1)
