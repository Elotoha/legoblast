.ClosDos	Move.l	$4.w,A6
	Move.l	DosBase,A1
	Jsr	-$19E(A6)
.ErrDos
	Clr.l	D0
	RTS

	***** Erreur de mémoire: on affiche ça...

ErrMem
	Move.l	$4.w,A6
	Lea	DosName,A1
	Clr.l	D0
	Jsr	-$228(A6)		OpenDos
	Move.l	D0,DosBase
	Beq.s	.ErrDos
	Move.l	D0,A6
	Jsr	_LVOOutPut(A6)
	Move.l	D0,DefOutPut
	Beq.s	.ClosDos	
	

	Move.l	Quit_ERRORCODE,D0
	Beq.s	.EC_Mem
	
	*** Erreur de chargement d'un fichier
.EC_File	Move.l	#Err_Load,D2
	Bsr	Print
	Move.l	D0,D2
	Bsr	Print
	Bra.s	.EC_END

	*** Erreur de mémoire
.EC_Mem	Move.l	#Err_Mem,D2
	Bsr	Print

.EC_END	Move.l	#Err_END,D2
	Bsr	Print

.ClosDos	Move.l	$4.w,A6
	Move.l	DosBase,A1
	Jsr	-$19E(A6)

.ErrDos	Bra	ContMem


	***********	Print(D2:Adresse texte, DefOutPut: Handle)
Print	Movem.l	D0-D1/D3/A0-A4,-(A7)
	Move.l	DosBase,A6
	Tst.l	A6
	Beq.s	.ErrInit
	Move.l	DefOutPut,D1		
	Beq.s	.ErrInit
	Bsr	.SearchLen
	Jsr	_LVOWrite(A6)
.ErrInit	Movem.l	(A7)+,D0-D1/D3/A0-A4
	RTS
.SearchLen Movea.l	D2,A2
	Clr.l	D3
.LenLoop	Tst.b	(A2)+
	Beq.s	.LenLoopF		
	Addq.l	#1,D3
	Bra.s	.LenLoop
.LenLoopF	Cmp.l	#4096,D3		Pour limiter les dégâts si bug !
	Ble.s	.Ok
	Clr.l	D3	
.Ok	RTS
