	Clr.l	D1
	Lea	Levels,A3
	Lea	LevelsEnd,A5				Test2
.LoopZ1	Cmpa.l	A3,A5	Test limite nombre levels application
	Ble.s	.EndLZ1	
	Clr.l	D1
	Cmpa.l	A2,A4	Test limite fichier prefs
	Blt.s	.EndLZ1	
	Move.b	(A2)+,D1
	Beq.s	.LOk1
	Moveq	#-1,D1
.LOk1	Move.l	D1,4(A3)
	Adda.w	#8,A3
	Bra.s	.LoopZ1	
.EndLZ1	
	
