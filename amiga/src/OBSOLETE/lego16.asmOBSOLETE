.NoCycle	********* FLASH
	Tst.w	ExeFlash
	Beq.s	.NoFlash
	Move.w	LevelInfoState,D0
	Blt.s	.NoFlash
	Cmp.w	#1,D0
	Bgt.s	.NoFlash	
	Move.w	Flash_Cpt,D0
	Dbf	D0,.NoEnd
	Move.w	#Flash_Time,Flash_Cpt
	Move.l	Flash_Coul1,D0
	Move.l	Flash_Coul2,Flash_Coul1
	Move.l	D0,Flash_Coul2
	Move.l	D0,RGB
	Move.w	Flash_CoulNumber,Number
	Bsr	Colour
	Bra.s	.NoFlash
