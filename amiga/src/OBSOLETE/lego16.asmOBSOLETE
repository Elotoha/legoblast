INITS	*** On met le level pour tous les modes sauf "1 Level"
	Jsr	RestoreMainBox

	Move.w	LevelMode,D0
	Bne	.No0		

	***************** RANDOM
* On teste d'abord pour savoir si on doit générer un nouveau level
	Tst.w	TypTouche
	Bgt.s	.RGen			>0: Regénère
	Beq	.SuitIn			=0: Même
	Move.w	NLevelPrev,NLevel		<0: Précédent
	Bra	.SuitIn
	**
.RGen	Clr.l	D7
	Move.l	LevelsAdr,A1		On compte, on fait RND
.LoopCh	Move.l	(A1)+,D0
	Beq.s	.EndLCh
	Cmp.w	#1,PlayerMode	1:Team
	Beq.s	.AlLevels

	Move.l	#NbLevelsParWorld,D5
	Mulu.w	#2*4*5,D5		(2 .L par level pour 5 mondes de .. Lvl)
	Add.l	#Levels,D5
	Cmp.l	D5,A1
	*Cmp.l	#LevelF01,D0	Seulement mode teams
	Beq.s	.EndLCh
.AlLevels	Tst.l	(A1)+
	Bne.s	.LoopCh
	Addq.w	#1,D7		Un level de plus....		
	Bra.s	.LoopCh
.EndLCh	Tst.w	D7
	Beq	.No0		Séquentiel puisque erreur...

	Movem.l	MemRnd1,D0-D1
	Jsr	Rnd_Engine
	Movem.l	D0-D1,MemRnd1
	And.l	#$0FFF,D0
	Divu.w	D7,D0	
	Swap	D0
	* On a D0 = 0-(N-1)
	* Maintenant il faut trouver le Nième N° libre....
	* Si c bon, pas de plantage, donc on arrive jamais au bout !

	Move.l	LevelsAdr,A1
	Suba.w	#8,A1
	Moveq	#-1,D7
.LoopC2	Adda.w	#8,A1
	Addq.w	#1,D7
	Tst.l	4(A1)
	Bne.s	.LoopC2
	Dbf	D0,.LoopC2	

	Move.w	NLevel,NLevelPrev	

	Move.w	D7,NLevel			

	Bra.s	.SuitIn
.No0
	Move.w	NLevel,D5
	Cmp.w	NLevelPrev,D5
	Beq.s	.NoAffec
	Move.w	NLevel,NLevelPrev	
.NoAffec	
	***************** SEQUENTIAL
	Cmp.w	#1,D0
	Bne.s	.No1
	Move.w	#500,D5	<--- Sécurité pour éviter boucle infinie
	Move.w	NLevel,D0
.RecNex	Dbf	D5,.Dec
	Bra	ORCHESTRE2	Erreur: on revient au menu
.Dec	Addq.w	#1,D0
	Move.l	LevelsAdr,A1
	Lea	(A1,D0.w*8),A1
	Tst.l	(A1)		Pointeur sur menu = 0...
	Beq.s	.Loop
	Tst.l	4(A1)
	Bne.s	.RecNex
	Move.w	D0,NLevel
	Bra.s	.SuitIN	
.Loop	Move.w	#-1,D0
	Bra.s	.RecNex
.No1
	***************** DYNABLASTER
	Cmp.w	#3,D0
	Bne.s	.No3
	Move.w	#-1,NLevel
	Jsr	DynaInit
	Bra	.SuitIn	

.No3
