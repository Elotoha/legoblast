	Lea	Prefs_LevelsSet(A1),A2	LEVELS
	Movea.l	A2,A4
	Adda.w	#Prefs_LevelsSet_END-Prefs_LevelsSet,A4	
	Clr.l	D1		
	Move.l	LevelsAdr,A3
	Movea.l	#LevelsEnd,A5
