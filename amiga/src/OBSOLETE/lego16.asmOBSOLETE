.Loop	Clr.l	(A0)+
	Clr.l	(A1)+
	Clr.l	(A2)+
	Clr.l	(A3)+	1 Dim4: 4 fois plus gros que les autres
	Clr.l	(A3)+	2
	Clr.l	(A3)+	3
	Clr.l	(A3)+	4
	Clr.l	(A4)+
	Clr.l	(A5)+
	Clr.l	(A6)+	
	Dbf	D0,.Loop
	Move.l	DimIA1,A0			Tableau de bombes
	Move.w	#SizeDimIA1/4-1,D0
