	Move.l	BarreDecounter,D0
	Beq.s	.OkBD
	Subq.l	#1,D0
	Move.l	D0,BarreDecounter
	Bgt.s	.OkBD
	Bsr	Set3
.OkBD	Subq.l	#1,AutoDecounter
	Bge.s	.OkAD
	Clr.l	AutoDecounter
.OkAD	

	**********************

	Movem.l	D0-D7/A0-A6,-(A7)
	********************************	Musique P6
	IFNE	Music_Activation

	 Tst.w	ExeZik
	 Beq.s	.NoZik
	 Movem.l	Sauve,D0-D7/A0-A6
