	Tst.l	D3
	Beq.s	.SECONDS
	Clr.l	SemaTime		0: on affiche les secondes
.OkST2	Lea	Msg4C2,A2		one minute (singulier) 
	Cmp.l	#1,D3
	Beq.s	.Cop13
	Move.b	#" ",(A3)+
	Moveq	#2,D6	nb chiffres	
	Clr.l	D7	Pas de remplissage à gauche
	Bsr	STR	* Ne modifie pas : D0-D2/A0-A1/A3-A7
.Cop12	Move.b	(A2)+,D2
	Beq.s	.EndC12
	Move.b	D2,(A3)+
	Bra.s	.Cop12
.EndC12	Lea	Msg4C,A2		MinuteS (pluriel)
.Cop13	Move.b	(A2)+,D2
	Beq.s	.EndC13
	Move.b	D2,(A3)+
	Bra.s	.Cop13
.EndC13

.SECONDS	***********
	Move.l	TotalPlayingTime,D3
	Divu.l	#Seconde,D3
	Beq.s	.NoTime
	Divu.w	#60,D3		On vire les minutes(donc heures)
	Swap	D3
	Ext.l	D3
	*Tst.l	SemaTime
	*Beq.s	.OkST
	Tst.l	D3
	Beq.s	.NoSc	Pour "You played 1 hour" 
.OkST	
	Tst.l	SemaTime
	Bne.s	.EndC35
	Lea	Msg4A,A2		"and"
.Cop35	Move.b	(A2)+,D2
	Beq.s	.EndC35
	Move.b	D2,(A3)+
	Bra.s	.Cop35
.EndC35
	Lea	Msg4D2,A2
	Cmp.l	#1,D3
	Beq.s	.Cop33
	Move.b	#" ",(A3)+
	Moveq	#2,D6	2 chiffres
	Clr.l	D7	Pas de remplissage à gauche
	Bsr	STR	* Ne modifie pas : D0-D2/A0-A1/A3-A7
.Cop32	Move.b	(A2)+,D2
	Beq.s	.EndC32
	Move.b	D2,(A3)+
	Bra.s	.Cop32
.EndC32	Lea	Msg4D,A2
.Cop33	Move.b	(A2)+,D2
	Beq.s	.EndC33
	Move.b	D2,(A3)+
	Bra.s	.Cop33
.EndC33
.NoSc
	Lea	Msg4E,A2		Copie avec le "0"
.Cop34	Move.b	(A2)+,D2
	Move.b	D2,(A3)+
	Bne.s	.Cop34	
	
	Move.l	#StrWork,D2
	Bsr	Print
.NoTime

