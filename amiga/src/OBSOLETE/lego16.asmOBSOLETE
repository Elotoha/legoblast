ClearDims
	Move.l	Dim1,A0
	Move.l	Dim2,A1
	Move.l	Dim3,A2
	Move.l	Dim4,A3
	Move.l	Dim5,A4
	Move.l	Dim6,A5
	Move.l	Dim7,A6
