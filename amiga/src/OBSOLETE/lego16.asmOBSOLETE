	Move.w	#35,D1	Erreur de valeur: valeur par défaut
.OkV2	Move.w	D1,SoundVol


	*** MUSIQUE
	Move.w	Prefs_Zik(A1),ActualZik
	Move.w	ActualZik,MusicRequest

	*** LEVELS
	Lea	Prefs_LevelsSet(A1),A2	0:ok -1:pas autorisé
	Movea.l	A2,A4
