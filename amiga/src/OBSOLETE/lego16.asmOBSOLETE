	Ble.s	.EndLZ1		
	Adda.w	#4,A3
	Move.l	(A3)+,D1
	Sne	D1	Pour avoir Word_droite(D1) à -1 si D1<>0	
	Cmpa.l	A2,A4		Test place dispo dans fichier Prefs
	Ble.s	.EndLZ1			
	Move.b	D1,(A2)+
	Bra.s	.LoopZ1	
