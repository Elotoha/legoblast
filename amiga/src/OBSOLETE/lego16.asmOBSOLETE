	Tst.w	Cycle_Activate
	Beq.s	.NoCycle
	*** Attente ou execution ?
	Move.w	Cycle_Wait,D0
	Subq.w	#1,D0
	Bge.s	.OkCyc
	Move.w	Cycle_Speed,D0
.OkCyc	Move.w	D0,Cycle_Wait
	Bgt.s	.NoCycle
	Move.l	Cycle_PalAdr,A0
	Move.w	Cycle_FirstCoul,D0
	Move.w	Cycle_LastCoul,D1
	Tst.w	Cycle_Activate
	Blt.s	.Inv
	Jsr	CyclePalette
