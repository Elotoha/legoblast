SetCopList
	Bsr	Set1
*	Bsr	Set5
	Bsr	Set2
	Bsr	Set3
	Move.l	CopList1,Cop1Lch
	Clr.w	CopJmp1

	RTS


Set1	* Sprites et écran 320*256*128
	Move.w	#$7FFF,DMACon
	Move.w	#0,BplCon0
	Clr.l	Rien
	Move.l	CopList1,A0	************** DEBUT COPPERLISTE
