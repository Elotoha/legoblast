	********************************	EFFETS DE PALETTE
	Tst.l	PALETTE_IN_PROGRESS
	Bne	.NotOkP
	********* FADING
	Tst.w	FadeBtw_Activate
	Beq.s	.NoFade
	Jsr	FadeBtw_Run
	Bra.s	.NoCycle		Pas de cycle si fading !
