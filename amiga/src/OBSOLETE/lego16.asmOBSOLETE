	CopMove	#$2c81-$100*YOFFNEG,#$8E	DiwStrt	$2c81
	CopMove	#$2bc1,#$90		DiwStop	$2bc1
	CopMove	#$38,#$92			ddfstrt	$38
	CopMove	#$d0-8,#$94		ddfstop	$d0
