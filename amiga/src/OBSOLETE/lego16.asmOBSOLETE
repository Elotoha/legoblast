	Move.l	A0,CopAdrSprite0
	CopSprite	#rien,0
	Move.l	A0,CopAdrSprite1
	CopSprite	#Rien,1
	Move.l	A0,CopAdrSprite2
	CopSprite	#rien,2	
	Move.l	A0,CopAdrSprite3
	CopSprite #rien,3
	Move.l	A0,CopAdrSprite4
	CopSprite	#rien,4	
	Move.l	A0,CopAdrSprite5
	CopSprite #rien,5
	Move.l	A0,CopAdrSprite6
	CopSprite	#rien,6	
	Move.l	A0,CopAdrSprite7
	CopSprite #rien,7
