************* Afficher toutes les jauges de victoire possibles
* 	    et inimaginables :-)
*
AfficheAllVictoires
	**** TEAMS
	Moveq	#0,D3			Victoires équipes
	Bsr	AfficheVictoiresTeams
	Moveq	#1,D3	
	Bsr	AfficheVictoiresTeams
	**** INDIVIDUAL
	Move.l	LegoPtr,A0
	Clr.l	D3
.LoopJ	Bsr	AfficheVictoires
	Adda.w	#Leg_SizeOf,A0
	Addq.w	#1,D3
	Cmp.w	#NbJoueurs,D3
	Ble.s	.LoopJ

	RTS
	
	
*************	Afficher le nombre de victoires d'un mec
*
* D3: N° du joueur
* A0: structure joueur
*
* Travail: D4/A1-A2
*
AfficheVictoires
	Tst.w	GameMode		Seulement en mode "5 Win Match"
	Beq	.NoGM	
	Tst.w	PlayerMode	Seulement en mode "Individuel"
	Bne	.NoGM	
	
	Lea	JaugDat,A1	18*6 = 108 octets
	Clr.w	D4
	Move.w	(Victoires,D3.w*2),D4
	Mulu.w	#18*6,D4
	Lea	(A1,D4.w),A1	Pointeur Jauge actuelle
	
	Movea.l	BarrePtr,A2
*	Move.w	Leg_BarreY(A0),D4	
*	Mulu.w	#SizeLine*2,D4
	Clr.w	D4
	Add.w	Leg_BarreX(A0),D4	D4: Offset sur l'écran
	Lea	-1(A2,D4.w),A2	Pointeur sur l'écran

	Moveq	#6-1,D4
.LoopPl	Move.b	6(A1),SizeLine*2(A2)
	Move.b	6*2(A1),2*SizeLine*2(A2)
	Move.b	6*3(A1),3*SizeLine*2(A2)
	Move.b	6*4(A1),4*SizeLine*2(A2)
	Move.b	6*5(A1),5*SizeLine*2(A2)
	Move.b	6*6(A1),6*SizeLine*2(A2)
	Move.b	6*7(A1),7*SizeLine*2(A2)
	Move.b	6*8(A1),8*SizeLine*2(A2)
	Move.b	6*9(A1),9*SizeLine*2(A2)
	Move.b	6*10(A1),10*SizeLine*2(A2)
	Move.b	6*11(A1),11*SizeLine*2(A2)
	Move.b	6*12(A1),12*SizeLine*2(A2)
	Move.b	6*13(A1),13*SizeLine*2(A2)
	Move.b	6*14(A1),14*SizeLine*2(A2)
	Move.b	6*15(A1),15*SizeLine*2(A2)
	Move.b	6*16(A1),16*SizeLine*2(A2)
	Move.b	6*17(A1),17*SizeLine*2(A2)
	Move.b	(A1)+,(A2)
	Adda.w	#SizePlanBarre,A2
	Dbf	D4,.LoopPl
	
.NoGM	RTS
	


*************	afficher le nombre de victoires d'une équipe
*
* D3: N° de l'équipe (0/1)
*
* Travail: D4/A0-A2
*
AfficheVictoiresTeams
	Tst.w	GameMode		Seulement en mode "5 Win Match"
	Beq	.NoGM	
	Tst.w	PlayerMode
	Beq	.NoGM		Seulement en mode "Teams"
	
	Lea	JaugDatT,A1	18*2*6 = 216 octets
	Clr.w	D4
	Move.w	(VictoiresEq,D3.w*2),D4
	Mulu.w	#18*2*6,D4
	Lea	(A1,D4.w),A1	Pointeur Jauge actuelle
	
	Tst.w	ModeAct
	Beq.s	.Ok4
	Addq.w	#2,D3
.Ok4
	Movea.l	BarrePtr,A2
	Lea	TeamVictPos,A0
	Move.w	(A0,D3.w*2),D4	D4: Offset sur l'écran
	Lea	-1(A2,D4.w),A2	Pointeur sur l'écran

	Moveq	#6-1,D4
.LoopPl	Move.w	6*2(A1),SizeLine*2(A2)
	Move.w	6*2*2(A1),2*SizeLine*2(A2)
	Move.w	6*3*2(A1),3*SizeLine*2(A2)
	Move.w	6*4*2(A1),4*SizeLine*2(A2)
	Move.w	6*5*2(A1),5*SizeLine*2(A2)
	Move.w	6*6*2(A1),6*SizeLine*2(A2)
	Move.w	6*7*2(A1),7*SizeLine*2(A2)
	Move.w	6*8*2(A1),8*SizeLine*2(A2)
	Move.w	6*9*2(A1),9*SizeLine*2(A2)
	Move.w	6*10*2(A1),10*SizeLine*2(A2)
	Move.w	6*11*2(A1),11*SizeLine*2(A2)
	Move.w	6*12*2(A1),12*SizeLine*2(A2)
	Move.w	6*13*2(A1),13*SizeLine*2(A2)
	Move.w	6*14*2(A1),14*SizeLine*2(A2)
	Move.w	6*15*2(A1),15*SizeLine*2(A2)
	Move.w	6*16*2(A1),16*SizeLine*2(A2)
	Move.w	6*17*2(A1),17*SizeLine*2(A2)
	Move.w	(A1)+,(A2)
	Adda.w	#SizePlanBarre,A2
	Dbf	D4,.LoopPl
	
.NoGM	RTS
	



	******************* pour le cadre de début de level...
	

RestoreWorkingScreen
	Movem.l	D0-D7/A0-A6,-(A7)
	Move.l	Planar,A1
	Move.l	A1,A0
	Adda.l	#7*SizePlan,A0
	Bra.s	AllWrkScr

BackupWorkingScreen
	Movem.l	D0-D7/A0-A6,-(A7)
	*** Copie brute de l'écran de travail	(Sauvgegarde)
	Move.l	Planar,A0
	Move.l	A0,A1
	Adda.l	#(NbPlans+1)*SizePlan,A1
AllWrkScr	Move.l	#(SizePlan*8)/(12*4)-1,D0    Ca fait 1280-1=1279
.Loop	Movem.l	(A0),D1-D7/A2-A6		12 registres
	Movem.l	D1-D7/A2-A6,(A1)
	Adda.l	#12*4,A0	
	Adda.l	#12*4,A1	
	Dbf	D0,.Loop
	Movem.l	(A7)+,D0-D7/A0-A6
	RTS


RestoreWorkingScreenEHB
	Movem.l	D0-D7/A0-A6,-(A7)
	Movea.l	Planar,A1			A1: Actuel
	Movea.l	A1,A0
	Adda.l	#(NbPlans+1)*SizePlan,A0	A0: Ancien
	Movea.l	A1,A2
	Adda.l	#6*SizePlan,A2		A2: Plan 7 !
	Movea.l	A2,A3
	Adda.l	#SizePlan,A3	Limite supérieure
	Move.l	#(SizePlan*NbPlans)/4-1,D0    Ca fait 1280-1=1279
.Loop	Move.l	(A1)+,D1		Plan0:  %110
	Move.l	(A0)+,D2
	Eor.l	D2,D1		Ancien: %100 -> 010
	Not.l	D1
	And.l	D1,(A2)+		Modifs à 0 !
	Cmpa.l	A3,A2
	Blt.s	.Ok
	Suba.l	#SizePlan,A2
.Ok	Dbf	D0,.Loop

*	Movea.l	Planar,A1			
*	Adda.l	#NbPlans*SizePlan,A1	A1: Plan 7
*	Move.l	#SizePlan/4-1,D0    Ca fait 1280-1=1279
*.Loop2	Not.l	(A1)+
*	Dbf	D0,.Loop2

	Movem.l	(A7)+,D0-D7/A0-A6
	RTS
	
		

*************** Sauvegarder la palette
*
* (D0: Nombre de banques à SAUVER (de 32 couleurs) )
* pour le mode EHB, par défaut on prend 2 banques à transformer
*		
MakePaletteEHB
	Movem.l	D1-D7/A0-A6,-(A7)
	Moveq	#4,D0		4 banques à sauver
	Bsr	PaletteBackup
	Move.w	#$4C00,D7		Valeur normale: banque 2 (0-7)
	Moveq	#2-1,D0		2 banques à transformer

	* On se s'occupe que des poids forts
	Lea	PalWork2,A0	Sauvegarde
	Move.w	D0,D2		Nombre de banques à lire
.Loop6	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop5	Move.w	(A0)+,D3
	Lsr.w	#1,D3
	And.w	#$FF77,D3
	Move.w	D3,(A1)+	Poids forts
	Dbf	D1,.Loop5
	Add.w	#$2000,D7
	Dbf	D2,.Loop6
	Move.w	#%0000001000111111,BplCon2	Kill EHB+ Priorités Sprites
	Move.w	#0,BplCon3	On restaure N° banque+bit L/H
	Movem.l	(A7)+,D1-D7/A0-A6
	RTS



*************** Restaurer la palette
*
* D0: Nombre de banques (de 32 couleurs) à restorer
*		
PaletteRestore
	Movem.l	D1-D7/A0-A6,-(A7)
	Lea	PalWork2,A0	Sauvegarde
	Subq.w	#1,D0
	Move.w	#$0C00,D7		Valeur normale
	Move.w	D0,D2		Nombre de banques à lire
.Loop6	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop5	Move.w	(A0)+,(A1)+		Poids forts
	Dbf	D1,.Loop5
	Add.w	#$2000,D7
	Dbf	D2,.Loop6

	Move.w	#$0C00,D7		Valeur normale
	bset	#9,D7
	Move.w	D0,D2		Nombre de banques à lire
.Loop8	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop7	Move.w	(A0)+,(A1)+	Poids faibles
	Dbf	D1,.Loop7
	Add.w	#$2000,D7
	Dbf	D2,.Loop8
	Move.w	#0,BplCon3	On restaure N° banque+bit L/H

	Move.w	#0,BplCon3	On restaure N° banque+bit L/H
	Movem.l	(A7)+,D1-D7/A0-A6
	RTS


*************** Initiliser la palette à 0
*
* D0: Nombre de banques (de 32 couleurs) à initialiser
*		
PaletteInit
	Movem.l	D1-D7/A0-A6,-(A7)
	Subq.w	#1,D0
	Move.w	#$0C00,D7		Valeur normale
	Move.w	D0,D2		Nombre de banques à lire
.Loop6	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop5	Clr.w	(A1)+		Poids forts
	Dbf	D1,.Loop5
	Add.w	#$2000,D7
	Dbf	D2,.Loop6

	Move.w	#$0C00,D7		Valeur normale
	bset	#9,D7
	Move.w	D0,D2		Nombre de banques à lire
.Loop8	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop7	Clr.w	(A1)+		Poids faibles
	Dbf	D1,.Loop7
	Add.w	#$2000,D7
	Dbf	D2,.Loop8
	Move.w	#0,BplCon3	On restaure N° banque+bit L/H
	Movem.l	(A7)+,D1-D7/A0-A6
	RTS




******************************* Sauver D0 banques de palette

PaletteBackup
	Move.w	#1<<8,BplCon2	Lecture registres couleur
	Lea	PalWork2,A0	Sauvegarde
	Move.w	#$0C00,D7		Valeur normale
	Subq.w	#1,D0
	Move.w	D0,D2	Nombre de banques à lire
.Loop2	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop1	Move.w	(A1)+,(A0)+	Poids forts
	Dbf	D1,.Loop1
	Add.w	#$2000,D7
	Dbf	D2,.Loop2

	Move.w	#$0C00,D7		Valeur normale
	bset	#9,D7
	Move.w	D0,D2	
.Loop4	Move.w	D7,BplCon3	Banque	
	Lea	$dff180,A1
	Moveq	#31,D1
.Loop3	Move.w	(A1)+,(A0)+	Poids faibles
	Dbf	D1,.Loop3
	Add.w	#$2000,D7
	Dbf	D2,.Loop4

	Move.w	#0,BplCon2	Mode écriture
	RTS

********	Créer un dégradé
*
* D0: N° de la couleur de départ
* D1: N° de la couleur de fin
* D2: N° du dégradé dans les data (0-n)
* A0: Adresse de la palette à modifier 
*
* D2-D4: Composantes actuelles 
* D5-D7: Vecteurs
*
* Remarque: j'ai fait au plus simple sans chercher à optimiser à outrance
* tout simplement parce que cela n'est pas destiné à être realtime.
* J'ai donc fait des double Swap au lieu de AddX...
*
MakeDegrad
	Lea	DegradesDat,A1
	Mulu.w	#6,D2
	Lea	(A1,D2.w),A1	Adresse dégradé	
	Sub.w	D0,D1	D1: Nb couleurs-1
	Clr.l	D2
	Clr.l	D3
	Clr.l	D4
	Clr.l	D5
	Clr.l	D6
	Clr.l	D7
	Move.b	(A1)+,D2
	Move.b	(A1)+,D3
	Move.b	(A1)+,D4
	Move.b	(A1)+,D5
	Move.b	(A1)+,D6
	Move.b	(A1)+,D7
	Swap	D2
	Swap	D3
	Swap	D4
	Swap	D5
	Swap	D6
	Swap	D7
	Sub.l	D2,D5
	Sub.l	D3,D6
	Sub.l	D4,D7
	Divs.l	D1,D5
	Divs.l	D1,D6
	Divs.l	D1,D7
	Lea	(A0,D0.w*4),A1	Adresse départ modif
	Bsr	.CopCoul		A0: Départ palette = Couleur 0
	*Move.l	#$ffff00,(A0)
	Movea.l	A1,A0
.Loop	Bsr	.CopCoul
	Add.l	D5,D2
	Add.l	D6,D3
	Add.l	D7,D4
	Lea	4(A0),A0
	Dbf	D1,.Loop		
	RTS
.CopCoul	Clr.l	D0
	Swap	D2
	Swap	D3
	Swap	D4
	Move.b	D2,D0
	Lsl.w	#8,D0
	Move.b	D3,D0
	Lsl.l	#8,D0
	Move.b	D4,D0	
	Move.l	D0,(A0)
	Swap	D2
	Swap	D3
	Swap	D4
	RTS

********  Passer au dégradé suivant
*
* <-> D1 (E/S)
*
NextDegrade
	Addq.w	#1,D1
	Cmp.w	#NbDegrades,D1
	Blt.s	.OkD
	Clr.w	D1
.OkD	RTS

********	Copier une zone
*
* A0: Adresse source
* A1: Adresse destination
* D0: Taille à copier en long-word
*
CopZone
	Subq.w	#1,D0
.Cop	Move.l	(A0)+,(A1)+	
	Dbf	D0,.Cop		
	RTS		
		



		