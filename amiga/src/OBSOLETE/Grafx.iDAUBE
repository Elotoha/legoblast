	Move.l	(A1)+,(A0)+
	Move.l	(A1)+,(A0)+
	Move.l	(A1)+,(A0)+
	Move.l	(A1)+,(A0)+
	Move.l	(A1)+,(A0)+
	Move.l	(A1)+,(A0)+
	Adda.w	#SizePlanBarre-2*sizeline,A1
	Dbf	D0,.LoopPl
