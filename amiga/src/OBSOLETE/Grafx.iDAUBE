	Move.l	(A0)+,(A1)+
	Move.l	(A0)+,(A1)+
	Move.l	(A0)+,(A1)+
	Dbf	D0,.Cop
	Movem.l	(A7)+,D0-D4/A0-A1
	RTS


ClsBAR
