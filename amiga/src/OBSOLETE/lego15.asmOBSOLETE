	******************************	FIN VBL

IntRoutine2 *** CLAVIER
	Movem.l	D0-D3/A0,-(A7)
	Moveq	#127,D0
	Clr.l	D1
 	Move.b	$bfec01,D1
	Move.w	SomClav,D3
	Addq.w	#1,D3
	Clr.l	D2
	Lsr.b	#1,D1
	Addx.l	D2,D2
	Bne.s	.App
.Lach	Subq.w	#2,D3
	Bge.s	.App
	Clr.w	D3
.App	Sub.b	D1,D0
	Movea.l	ClavierPtr,A0
	And.w	#$FF,D0
	Move.b	D2,(A0,D0.w)
	*** Spécial pour la répétition des touches
*	Bne.s	.NoLach
*	Movea.l	ClavierPtr2,A0
*	Move.b	(A0,D0.w),D1
*	Beq.s	.NoLach
*	Subq.b	#1,D1
*	Move.b	D1,(A0,D0.w)
*.NoLach	***
	Move.w	D3,SomClav
	Movem.l	(A7)+,D0-D3/A0
	Lea	$dff000,a0
	RTS

* 58 -> 69	127-58 = 69
* 63 -> 64	127-63 = 64
* 127-C

* INTERRUPTION:
* On peut virer D0-D1/A0-A1/A5-A6
* DONC 	Movem.l	D2-D7/A2-A4,-(A7)
*	Movem.l	(A7)+,D2-D7/A2-A4
*
*

IntRoutine3 *** SONS CHANNEL 3	
	Tst.w	OkSon3		Départ de son au lieu de fin ?
	Bne.s	.Ok
	Subq.w	#1,Son3Loops	Son pas terminé: en boucle
	Bge.s	.Ok
	Move.w	#0,Aud3Dat
	Move.w	#1<<3,DmaCon	Channel 3 Off	
	Moveq	#3,D0
	Bsr	RasterWaitH	
	Move.w	#0,ChannelUse3
	Move.w	#1<<10,IntEna	Off Son 3 (-> Interrupt départ son!)
.Ok	Clr.w	OkSon3
	Move.w	#1<<10,IntReq	Aud3 à 0
	RTS

IntRoutine4 *** SONS CHANNEL 2
	Tst.w	OkSon2
	Bne.s	.Ok
	Subq.w	#1,Son2Loops	Son pas terminé: en boucle
	Bge.s	.Ok
	Move.w	#0,Aud2Dat
	Move.w	#1<<2,DmaCon	Channel 2 Off	
	Moveq	#3,D0
	Bsr	RasterWaitH	
	Move.w	#0,ChannelUse2
	Move.w	#1<<9,IntEna	Off Son 2 (-> Interrupt départ son!)
.Ok	Clr.w	OkSon2
	Move.w	#1<<9,IntReq	Aud2 à 0
	RTS

IntRoutine5 *** SONS CHANNEL 1
	Tst.w	OkSon1
	Bne.s	.Ok
	Subq.w	#1,Son1Loops	Son pas terminé: en boucle
	Bge.s	.Ok
	Move.w	#0,Aud1Dat
	Move.w	#1<<1,DmaCon	Channel 1 Off	
	Moveq	#3,D0
	Bsr	RasterWaitH	
	Move.w	#0,ChannelUse1
	Move.w	#1<<8,IntEna	Off Son 1 (-> Interrupt départ son!)
.Ok	Clr.w	OkSon1
	Move.w	#1<<8,IntReq	Aud1 à 0
	RTS

IntRoutine6 *** SONS CHANNEL 0
	Tst.w	OkSon0
	Bne.s	.Ok
	Subq.w	#1,Son0Loops	Son pas terminé: en boucle
	Bge.s	.Ok
	Move.w	#0,Aud0Dat
	Move.w	#1,DmaCon		Channel 0 Off	
	Moveq	#6,D0
	Bsr	RasterWaitH	
	Move.w	#0,ChannelUse0
	Move.w	#1<<7,IntEna	Off Son 0 (-> Interrupt départ son!)
.Ok	Clr.w	OkSon0
	Move.w	#1<<7,IntReq	Aud0 à 0
	RTS

IntRoutine7 *** COPPER (SOFT)

*	Move.w	#$0FF,$dff180

	RTS

	IFNE Music_Activation


	***** Balarguer une musique
	*
	* D0: N° de la musique
	*
LaunchZik	Movem.l	D0-D7/A0-A6,-(A7)
	Tst.w	D0		Pour désactiver request (menus)
	Bge.s	.NoMReq

	Tst.w	MusicRequest
	Beq.s	.NoMReq
	Move.w	MusicRequest,D0

.NoMReq	Tst.w	D0		Anti-Bugs
	Blt	.NoNewZik
	Cmp.w	#9,D0
	Bgt	.NoNewZik		
	Move.w	D0,MemZik
	Beq.s	.OkR
	Cmp.w	MusicInProgress,D0
	Beq	.NoNewZik
.OkR	Tst.w	MusicInProgress
	Beq.s	.NoZikIPAv
	Clr.w	ExeZik
	Movem.l	Sauve,D0-D7/A0-A6
	Jsr	P61_End		P6
	WaitHard	#1
.NoZikIPAv
	* On rend la mémoire qui A été allouée

	Bsr	RendAllZikMem

*	Move.w	MusicInProgress,D0
*	Lsl.w	#4,D0	4.L = *16
*	Lea	(Musiques,D0.w),A0
*	Move.l	$4.w,A6
*	Move.l	(A0),A1		MusicNPtr
*	Move.l	4(A0),D0		MusicNLen
*	Clr.l	(A0)+		ON EFFACE LES DECLARATIONS :
*	Clr.l	(A0)		LA MUSIQUE N'EST >>PLUS<< EN MEMOIRE
*	Jsr	_LVOFreeMem(A6)
.NotInMem	
.NoZikIP	Clr.w	MusicInProgress
	*Move.l	#0,P61_Channels	PLANTE SI PAS DE FAST !!!!!!!
	Moveq	#1,D1		
	Move.w	D1,Voice3Free
	Move.w	D1,Voice2Free
	Move.w	D1,Voice1Free
	Move.w	D1,Voice0Free
	Move.w	MemZik,D0
	Beq	.NoNewZik
	Lsl.w	#4,D0
	Lea	(Musiques,D0.w),A6

	* Musique dans le disque: il faut la charger		
	Move.l	2*4(A6),A1	Nom du fichier
	Tst.l	A1
	Beq	.NoNewZik		Ligne de musique vide
	Move.l	(A6),A0		Test musique déjà en mémoire
	Tst.l	A0
	Beq.s	.InDisk
	Tst.l	4(A6)
	Bne.s	.InMem
.InDisk	Movea.l	A1,A0
	Move.l	#Chip,D1	
	******
	Movem.l	D2-D7/A2-A6,-(A7)
	Jsr	TEMP_RESTORE_SYSTEM
	Jsr	ChargeFichier 	A0/D1->A1/D0
	Jsr	TEMP_TAKE_SYSTEM
	Movem.l	(A7)+,D2-D7/A2-A6
	*******
	Movea.l	A1,A0		Pour utiliser cette nouvelle musique	
	Tst.l	D0
	Beq	.NoNewZik		ERREUR: on n'utilise pas cette musique
	Move.l	A1,(A6)+		MusicNPtr
	Move.l	D0,(A6)		MusicNLen
	Tst.l	ONLY_LOAD_ZIK
	Bne	.nonewzik
.InMem	* A0: Adresse de la musique en mémoire
	Move.w	#%0111,D1
	Btst	#3,D1
	Beq.s	.Util3
	Clr.w	Voice3Free	Piste non usable pour les sons ? 0
.Util3	Btst	#2,D1
	Beq.s	.Util2
	Clr.w	Voice2Free
.Util2	Btst	#1,D1
	Beq.s	.Util1
	Clr.w	Voice1Free
.Util1	Btst	#0,D1
	Beq.s	.Util0
	Clr.w	Voice0Free
.Util0	
	Moveq	#3,D1
	Move.w	MemZik,D0
	Cmp.w	#9,D0
	Bne.s	.NoMenu
	Moveq	#4,D1
.NoMenu	Move.l	D1,P61_Channels
	
	Move.l	#0,A1
	Move.l	#0,A2
	Jsr	P61_Init

	Tst.l	D0		D0=0:Ok
	Bne.s	.NoNewZik		Erreur d'init
	Movem.l	D0-D7/A0-A6,Sauve
	Move.w	MusicVol,P61_Master
	Move.w	MemZik,MusicInProgress
	Move.w	#-1,ExeZik	Musique ON

.NoNewZik	Movem.l	(A7)+,D0-D7/A0-A6
	Clr.l	ONLY_LOAD_ZIK
	RTS

RendAllZikMem
	Moveq.w	#8,D0
.LoopRA
	Move.l	D0,-(A7)
	Lsl.w	#4,D0	4.L = *16
	Lea	(Musiques,D0.w),A0
	Move.l	$4.w,A6
	Move.l	(A0),A1		MusicNPtr
	Tst.l	A1
	Beq.s	.NoZik
	Move.l	4(A0),D0		MusicNLen
	Clr.l	(A0)+		ON EFFACE LES DECLARATIONS :
	Clr.l	(A0)		LA MUSIQUE N'EST >>PLUS<< EN MEMOIRE
	Jsr	_LVOFreeMem(A6)
.NoZik	Move.l	(A7)+,D0

	Subq.w	#1,D0
	Bgt.s	.LoopRA
	RTS

	ENDC


************** Passer au Level suivant en fonction du mode
*
* MODE 0: Séquentiel
*      1: Toujours le même
*      2: RND
*
NextLevel
	Move.w	LevelMODE,D0	
	Beq.s	.Sequ

	***** TOUJOURS LE MEME LEVEL
	Cmp.w	#1,D0	
	Beq.s	.Ok

	***** LEVEL EN RND
.Rnd	Movem.l	MemRnd1,D0-D1
	Bsr	Rnd_Engine
	Movem.l	D0-D1,MemRnd1
	Clr.l	D1
	Divu.l	#NbLevels,D1:D0
	* >>>>>> A modifier <<<<<<<<
	Bra.s	.Ok
	
	***** LEVEL EN SEQUENTIEL	
.Sequ	Move.w	NLevel,D0	
	Addq.w	#1,D0
	Lea	Levels,A1
	Tst.l	(A1,D0.w*4)
	Bne.s	.PRien
	Clr.w	D0		En boucle
.PRien	Move.w	D0,NLevel


.Ok	RTS

***************************

SetCopList
	Bsr	Set1
	Bsr	Set2
	Bsr	Set3
	Move.l	CopList1,Cop1Lch
	Clr.w	CopJmp1

	RTS


Set1	* Sprites et écran 320*256*128
	Move.w	#$7FFF,DMACon
	Move.w	#0,BplCon0
	Clr.l	Rien
	Move.l	CopList1,A0	************** DEBUT COPPERLISTE
	CopMove	#%01,#$1FC		FMode %10 ou %01 pour Hires 6 plans
	Move.l	A0,CopAdrSprite0
	CopSprite	#rien,0
	Move.l	A0,CopAdrSprite1
	CopSprite	#Rien,1
	Move.l	A0,CopAdrSprite2
	CopSprite	#rien,2	
	Move.l	A0,CopAdrSprite3
	CopSprite #rien,3
	Move.l	A0,CopAdrSprite4
	CopSprite	#rien,4	
	Move.l	A0,CopAdrSprite5
	CopSprite #rien,5
	Move.l	A0,CopAdrSprite6
	CopSprite	#rien,6	
	Move.l	A0,CopAdrSprite7
	CopSprite #rien,7
	Move.l	A0,CopPlanAdr
	CopPlan	Planar,#SizePlan,#NbPlans+1	7 plans... ehb ???
	CopMove	#$2c81-$100*YOFFNEG,#$8E	DiwStrt	$2c81
	CopMove	#$2bc1,#$90		DiwStop	$2bc1
	CopMove	#$38,#$92			ddfstrt	$38
	CopMove	#$d0-8,#$94		ddfstop	$d0
	RTS

Set2	*  Attente de la position de l'info bar
	Move.l	A0,CopAdrBplCon0
*	CopMove	#%0110001000000001,#$100	BplCon0: 6 plans (lowres)
	CopMove	#%0111001000000001,#$100	BplCon0: 7 plans (lowres)
	CopMove	#$8100,#$96	DmaCon	ON
	Move.l	A0,CopEndPtr	***********
	CopWaitXY	#440,#255		#448
	CopWait	#28-YOFFNEG
	CopMove	#$100,#$96	DmaCon	OFF
	Move.l	A0,CopBarrePtr
	RTS

Set3	* Barre des joueurs en pierre (640*18*6)
	Move.l	CopBarrePtr,A0
	*** Début
	CopMove	#$3081-$60,#$8E		Diw/CopEnd
	CopMove	#$30c1,#$92
	CopMove	#$3c-$8,#$92			DDf
	CopMove	#$3c+(640/4-8)-$8,#$94
	Move.l	A0,Mem1
	*CopPlan	BarrePtr,#SizePlanBarre,#NbPlansBarre
	CopPlan	BarrePtr,#SizePlanBarre,#NbPlansBarre	
	CopWait	#30-YOFFNEG
	CopMove	#$8100,#$96	DmaCon	ON
	CopMove	#%1110001000000001,#$100	BplCon0: Hi-Res
	CopWait	#30+18-YOFFNEG
	CopMove	#$100,#$96	DmaCon	OFF	
	CopEnd
	RTS
	
Set4	* Barre d'informations en bois (320*18*6)
	Move.l	CopBarrePtr,A0
	CopPlan	Barre2,#SizePlanBarre2,#NbPlansBarre2
	CopWait	#30-YOFFNEG
	CopMove	#$8100,#$96	DmaCon	ON
	CopMove	#%0110001000000001,#$100	BplCon0: Lo-Res
	CopWait	#30+18-YOFFNEG
	CopMove	#$100,#$96	DmaCon	OFF		
	CopEnd
	*Move.l	CopList1,Cop1Lch
	*Clr.w	CopJmp1
	RTS
	

SetVierge
	Move.l	CopList1,A0	************** DEBUT COPPERLISTE
	CopMove	#$0100,#$096	Bpl off
	CopMove	#0,#$180
	CopEnd	
	Move.l	CopList1,Cop1Lch
	Clr.w	CopJmp1
	RTS

SetSimple
	Move.l	CopList1,A0	************** DEBUT COPPERLISTE
	*CopInitSprites
	CopMove	#$8100,#$96		Bitplans on
	CopMove	#$0020,#$96		Sprites OFF
	CopMove	#%0111001000000001,#$100	BplCon0
	CopPlan	Planar,#SizePlan,#NbPlans+1	7 plans...
	CopMove	#%01,#$1FC		FMode %10 ou %01 pour Hires 6 plans
	CopMove	#$2c81-$100*YOFFNEG,#$8E	DiwStrt	$2c81
	CopMove	#$2bc1,#$90		DiwStop	$2bc1
	CopMove	#$38,#$92			ddfstrt	$38
	CopMove	#$d0-8,#$94		ddfstop	$d0
	CopWaitXY	#440,#255			#448
	CopWait	#28-YOFFNEG
	CopMove	#%0000001000000001,#$100	BplCon0: Hi-Res
	CopMove	#$0100,#$96		Bitplans OFF
	CopEnd
	*VblWait	#30
	Move.l	CopList1,Cop1Lch
	Clr.w	CopJmp1
	RTS


SetScreenRegisters
*	Move.w	#$3081,DiwStrt	Machins a thunder
*	Move.w	#$30c1,DiwStop
*	Move.w	#$3c,ddfstrt
*	Move.w	#$3c+(320/4-8),ddfstop	
	
*	Move.w	#$2C81-$100*YOFFNEG,DiwStrt	YX   	$8E	
*	Move.w	#$2BC1+$500+$1,DiwStop			$90
*	Move.w	#$38,DDFStrt	=>Display Data Fetch Start (start et stop pour une seule ligne)
*	Move.w	#$D0+$1,DDFStop	=>Display Data Fetch Stop	
	Move.w	#%0110001000000000,BplCon0	hires,nb bitplans,64c,dual,couleur,genlock,0000,lpen,lace,synchro ext,0
	Move.w	#%0000000000000000,BplCon1	ScrollBitplan=0
	Move.w	#%0000001000111111,BplCon2	Kill EHB+ Priorités Sprites
	Move.w	#%0000110000000010,BplCon3		%10
	Move.w	#%0000000001010101,BplCon4	Palette sprites (Pair,Impair)
*	Move.w	#0,Bpl1Mod
*	Move.w	#0,Bpl2Mod
	
	*Bsr	ClearSprites
	*VblWait	#20
	DMASet	BitPlan|Copper|Sprite
	Move.w	#$C000+1<<5+1<<3,IntEna	Interruption Vbl+Clav $8020+Son 3
	Move.w	#$F000,ClxCon		Contrôle collisions sprites
	*Move.w	#%00,FMode
	Move.w	#$00FF,AdkCon

	
*	Move.w	#$8000+1<<3,DmaCon
*	Move.w	#0,IntReq
*	Move.b	#%00010111,$bfed01
*	Move.b	#%10001000,$bfed01
	RTS



