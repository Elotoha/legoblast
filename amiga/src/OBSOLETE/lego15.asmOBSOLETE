	Bne.s	.NoFree
	Jsr	GosubAffPODIUM	Stats seulement mode Free play
.NoFree
	BRA	ORCHESTRE2	ON BOUCLE SUR LE MENU


QUIT	Clr.w	ExeZik	

*******************		On quitte le programme

	Move.w	#$7fff,DmaCon
	Move.w	#$7fff,IntEna


***   Suppression de l'interruption COPPER

	Move.l	$4.w,A6
	Moveq	#2,D0		
	Move.l	OldIntSoft,A1	
*	Jsr	_LVOSetIntVector(A6)


***   Suppression de l'interruption CLAVIER

	Move.l	$4.w,A6
	Moveq	#32,D0		
	Lea	Int2,A1	
	Jsr	_LVORemIntServer(A6)


***   Suppression de l'interruption VBL

	VblWait	#250
	Move.l	$4.w,A6
	Moveq	#32,D0		
	Lea	Int1,A1	
	Jsr	_LVORemIntServer(A6)


***   Suppression des interruptions SONS

	Move.l	$4,A6
	Moveq	#10,D0		Son 3
	Move.l	OldIntSon3,A1	
	Jsr	_LVOSetIntVector(A6) 

	Move.l	$4,A6
	Moveq	#9,D0		Son 2
	Move.l	OldIntSon2,A1	
	Jsr	_LVOSetIntVector(A6) 

	Move.l	$4,A6
	Moveq	#8,D0		Son 1
	Move.l	OldIntSon1,A1	
	Jsr	_LVOSetIntVector(A6) 

	Move.l	$4,A6
	Moveq	#7,D0		Son 0
	Move.l	OldIntSon0,A1	
	Jsr	_LVOSetIntVector(A6) 


	
***   Suppression de la musique

	IFNE	Music_Activation
*	 Tst.w	MusicInProgress
*	 Beq.s	.NoZikIP
*	 VblWait	#5
*	 VblWait	#50
*	 VblWait	#5
*	 Movem.l	Sauve,D0-D7/A0-A6
*	 Jsr	P61_End		P6
*.NoZikIP

	 Moveq	#0,D0		Arrêt zik + rend memoire
	 Jsr	LaunchZik

	ENDC



***   Réactivation des copper-list systéme

	CloseScreenHard

***   Remise en route du systéme

*	IntOn
*	Move.l	$4.w,A6
*	Jsr	_LVOPermit(A6)

	Jsr	RestoreSystem

	Move.w	#$8180,DMACon	screen,copper ON
	Move.w	#$000F,DMACon	Couper son

	WaitHard	#5

	Move.l	#-1,SYSTEM_RESIDENT

***   Sauvegarde des fichiers debug

	Tst.w	ExeSauveScreen
	Beq.s	.NoSav
	Move.l	SauvePtr,SaveAdr
	Move.l	#7*SizePlan,SaveSize
	Move.l	#NomSauve,SaveName
	Bsr	SaveRoutine
.NoSav

*** Sauvegarde du fichier Préférences


PrefsW	ResMemStack #Prefs_SIZEOF,#Public,A1,ErrMem
	*
	**********		INIT VALEURS
	*
	Move.l	#"LEGO",Prefs_HEADER(A1)	HEADER
	Move.w	MusicVol,Prefs_MusicVol(A1)	VOLUME MUSIQUE
	Move.w	SoundVol,Prefs_SoundVol(A1)	VOLUME SONS
	Move.w	ActualZik,Prefs_Zik(A1)	MUSIQUE (dernière musique)
	Lea	Prefs_LevelsSet(A1),A2	LEVELS
	Clr.l	D1
	Lea	Levels,A3
.LoopZ1	Tst.l	(A3)+
	Beq.s	.EndLZ1
	Move.l	(A3)+,D1
	Sne	D1	Pour avoir Word_droite(D1) à -1 si D1<>0
	Move.b	D1,(A2)+
	Bra.s	.LoopZ1	
.EndLZ1	Lea	Prefs_MenusPtr(A1),A2	POINTEURS MENUS
	Lea	MenusPtr,A3
.LoopPR	Move.l	(A3)+,D2
	Move.l	(A3)+,D3
	Beq.s	.EndLPR
	Sub.l	D3,D2
	Move.l	D2,(A2)+
	Bra.s	.LoopPR
.EndLPR	Move.w	DegradeMenuA,Prefs_DegradeMenuA(A1)	DEGRADES
	Move.w	DegradeMenuB,Prefs_DegradeMenuB(A1)
	*
	*********			SAUVE PREFS
	*
	Move.l	#FichConfig,SaveName
	Move.l	A1,SaveAdr
	Move.l	#Prefs_SIZEOF,SaveSize
	Bsr	SaveRoutine

	**************************************

	*** On libère la mémoire utilisée par les images	
	Moveq	#MaxPictures-1,D1
	Clr.l	D0
.LoopFrP	Bsr	FreePic
	Addq.w	#1,D0
	Dbf	D1,.LoopFrP


	***   Libération de la mémoire
ContMem	FreMemStack

	Move.l	$4.w,A6		PRINT
	Lea	DosName,A1
	Clr.l	D0
	Jsr	-$228(A6)
	Move.l	D0,DosBase
	Beq	.ErrDos
	Move.l	D0,A6
	Jsr	_LVOOutPut(A6)
	Move.l	D0,DefOutPut
	Beq	.ClosDos	

	********************

	Lea	StrWork,A3

	Move.l	TotalPlayingTime,D3
	Divu.l	#Minute,D3
	Lea	Msg4_Only,A0
	Cmp.l	#7,D3	7 minutes mini pour joueur invétéré
	Blt.s	.Cop1
	Lea	Msg4,A0
.Cop1	Move.b	(A0)+,D2
	Beq.s	.EndC1
	Move.b	D2,(A3)+
	Bra.s	.Cop1
.EndC1	
.HOURS	***********
	Move.l	#-1,SemaTime
	Move.l	TotalPlayingTime,D3
	Divu.l	#Heure,D3
	Beq.s	.MINUTES
	Clr.l	SemaTime	Minutes obligatoires : "5 hours," 
	Lea	Msg4B2,A2
	Cmp.l	#1,D3
	Beq.s	.Cop3
	Move.b	#" ",(A3)+
	Moveq	#2,D6	chiffres		"1"
	Clr.l	D7	Pas de remplissage
	Bsr	STR	* Ne modifie pas : D0-D2/A0-A1/A3-A7
.Cop2	Move.b	(A2)+,D2
	Beq.s	.EndC2
	Move.b	D2,(A3)+
	Bra.s	.Cop2
.EndC2	Lea	Msg4B,A2
.Cop3	Move.b	(A2)+,D2
	Beq.s	.EndC3
	Move.b	D2,(A3)+
	Bra.s	.Cop3
.EndC3


.MINUTES	***********
	Move.l	TotalPlayingTime,D3
	Divu.l	#Minute,D3
	Ext.l	D3
	Divu.w	#60,D3
	Swap	D3
	Ext.l	D3
	*Tst.l	SemaTime
	*Beq.s	.OkST2
	Tst.l	D3
	Beq.s	.SECONDS
	Clr.l	SemaTime		0: on affiche les secondes
.OkST2	Lea	Msg4C2,A2		one minute (singulier) 
	Cmp.l	#1,D3
	Beq.s	.Cop13
	Move.b	#" ",(A3)+
	Moveq	#2,D6	nb chiffres	
	Clr.l	D7	Pas de remplissage à gauche
	Bsr	STR	* Ne modifie pas : D0-D2/A0-A1/A3-A7
.Cop12	Move.b	(A2)+,D2
	Beq.s	.EndC12
	Move.b	D2,(A3)+
	Bra.s	.Cop12
.EndC12	Lea	Msg4C,A2		MinuteS (pluriel)
.Cop13	Move.b	(A2)+,D2
	Beq.s	.EndC13
	Move.b	D2,(A3)+
	Bra.s	.Cop13
.EndC13

.SECONDS	***********
	Move.l	TotalPlayingTime,D3
	Divu.l	#Seconde,D3
	Beq.s	.NoTime
	Divu.w	#60,D3		On vire les minutes(donc heures)
	Swap	D3
	Ext.l	D3
	*Tst.l	SemaTime
	*Beq.s	.OkST
	Tst.l	D3
	Beq.s	.NoSc	Pour "You played 1 hour" 
.OkST	
	Tst.l	SemaTime
	Bne.s	.EndC35
	Lea	Msg4A,A2		"and"
.Cop35	Move.b	(A2)+,D2
	Beq.s	.EndC35
	Move.b	D2,(A3)+
	Bra.s	.Cop35
.EndC35
	Lea	Msg4D2,A2
	Cmp.l	#1,D3
	Beq.s	.Cop33
	Move.b	#" ",(A3)+
	Moveq	#2,D6	2 chiffres
	Clr.l	D7	Pas de remplissage à gauche
	Bsr	STR	* Ne modifie pas : D0-D2/A0-A1/A3-A7
.Cop32	Move.b	(A2)+,D2
	Beq.s	.EndC32
	Move.b	D2,(A3)+
	Bra.s	.Cop32
.EndC32	Lea	Msg4D,A2
.Cop33	Move.b	(A2)+,D2
	Beq.s	.EndC33
	Move.b	D2,(A3)+
	Bra.s	.Cop33
.EndC33
.NoSc
	Lea	Msg4E,A2		Copie avec le "0"
.Cop34	Move.b	(A2)+,D2
	Move.b	D2,(A3)+
	Bne.s	.Cop34	
	
	Move.l	#StrWork,D2
	Bsr	Print
.NoTime

	********************
	
.ClosDos	Move.l	$4.w,A6
	Move.l	DosBase,A1
	Jsr	-$19E(A6)
.ErrDos
	Clr.l	D0
	RTS

	***** Erreur de mémoire: on affiche ça...

ErrMem	Move.l	$4.w,A6
	Lea	DosName,A1
	Clr.l	D0
	Jsr	-$228(A6)
	Move.l	D0,DosBase
	Beq.s	.ErrDos
	Move.l	D0,A6
	Jsr	_LVOOutPut(A6)
	Move.l	D0,DefOutPut
	Beq.s	.ClosDos	

	Move.l	#Err_Mem,D2
	Bsr	Print

.ClosDos	Move.l	$4.w,A6
	Move.l	DosBase,A1
	Jsr	-$19E(A6)

.ErrDos	Bra	ContMem

	***********		Print(D2:Adresse texte)
Print	Movem.l	D0-D1/D3/A0-A4,-(A7)
	Move.l	DosBase,A6
	Move.l	DefOutPut,D1		
	Bsr	.SearchLen
	Jsr	_LVOWrite(A6)
	Movem.l	(A7)+,D0-D1/D3/A0-A4
	RTS
.SearchLen Movea.l	D2,A2
	Clr.l	D3
.LenLoop	Tst.b	(A2)+
	Beq.s	.LenLoopF		
	Addq.l	#1,D3
	Bra.s	.LenLoop
.LenLoopF	Cmp.l	#4096,D3		Pour limiter les dégâts si bug !
	Ble.s	.Ok
	Clr.l	D3	
.Ok	RTS
