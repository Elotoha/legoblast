.cop19	Move.b	(A2)+,D0
	Beq.s	.fi19
	Move.b	D0,(A3)+
	Bra.s	.cop19
.fi19	*Move.b	#"'",(A3)+
	*
	Lea	Phrase_Secondes2,A4		"0:27"
