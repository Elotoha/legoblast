*********************************

IntRoutine1 *** VBL
	********************** PRIORITE ABSOLUE...
	Movem.l	D0-D7/A0-A6,-(A7)
	Tst.w	ExeBarSamples
	Beq.s	.NoExBarS
	Move.l	Planar,A2
	Move.w	#Jauge_Rouge,D6		Rouge
	Moveq	#6,D7
	Clr.l	D2
	Move.w	SamplesLoaded,D2	Pix=(SamplesAct/NbSamples)*larg
	Mulu.w	#LargJaugeSamples,D2
	Divu.w	#NbSamples,D2
	Cmp.w	#LargJaugeSamples,D2
	Ble.s	.Ok
	Move.w	#LargJaugeSamples,D2	ANTIBUG dépassement
.Ok	Add.w	#XJaugeSamples,D2	
	Move.w	D2,JaugeMem1	Utilisation var déjà existante...
	Move.w	#XJaugeSamples,D0
	Move.w	#YJaugeSamples,D1
	Move.w	#YJaugeSamples+HautJaugeSamples,D3
	Bsr	BAR
	Move.l	Planar,A2
	Move.w	#Jauge_Gris,D6	Gris foncé
	Moveq	#6,D7
	Move.w	JaugeMem1,D0
	Move.w	#YJaugeSamples,D1
	Move.w	#XJaugeSamples+LargJaugeSamples,D2
	Move.w	#YJaugeSamples+HautJaugeSamples,D3
	Bsr	BAR
.NoExBarS
	Movem.l	(A7)+,D0-D7/A0-A6
	****************************** DEBUT NORMAL
	Tst.w	ExeGENERALVbl
	Bne.s	.OkGene
	RTS
.OkGene	Move.w	#-1,VblPassed
	Move.l	BarreDecounter,D0
	Beq.s	.OkBD
	Subq.l	#1,D0
	Move.l	D0,BarreDecounter
	Bgt.s	.OkBD
	Bsr	Set3
.OkBD
	Subq.l	#1,AutoDecounter
	Bge.s	.OkAD
	Clr.l	AutoDecounter
.OkAD	Addq.l	#1,AutoCounter

	**********************

	Movem.l	D0-D7/A0-A6,-(A7)
	********************************	Musique P6
	IFNE	Music_Activation
	****
	*Move.w	ActualZik,Temp1
	*Move.w	MusicRequest,Temp1+2
	*Move.w	MusicInProgress,Temp2
	*Move.l	Voice3Free,Temp1
	*Move.l	Voice1Free,Temp2
	*Moveq	#1,D1
	*Bsr	DEBUG
	****

	 Tst.w	ExeZik
	 Beq.s	.NoZik
	 Movem.l	Sauve,D0-D7/A0-A6
