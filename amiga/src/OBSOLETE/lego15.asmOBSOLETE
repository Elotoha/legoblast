	Beq.s	.NoSWP
	Clr.w	SamplesWait
	Move.w	SamplesTotal,D0
	Sub.w	SamplesLoaded,D0
	Beq.s	.NoSWP	On affiche que si Sons chargés < Sons au total
	Bsr	BAffNbSamples
.NoSWP

*****	PROGRAMME PRINCIPAL (Impressionant non ?)

Main	

	Tst.w	RequestForNewLevel
	Blt	INITS

	**** Tests Clavier

	Tst.w	ExeClavier
	Beq	.NoTouche
	Clr.w	ExeClavier	
	Tst.w	SomClav
	Beq	.NoTouche
	Movea.l	ClavierPtr,A0
	Tst.b	69(A0)	Escape
	Bne	.Quit
	*
	Tst.b	70(A0)	Del
	Beq.s	.NoDel
	Jsr	Set4
	Move.l	#Seconde*TimeBarre2Del,BarreDecounter		
.NoDel
	*
*	Tst.b	51(A0)	C comme couleur
*	Beq.s	.NoCoul
*	Move.w	#49,Number
*	Move.l	#$00FFFFFF,RGB
*	Jsr	Colour
*.NoCoul	

	*
	Tst.b	95(A0)	Help
	Beq.s	.NoRec
	Move.w	#0,TypTouche
	Bra	INITS
.NoRec	*
	Tst.b	25(A0)
	Beq.s	.NoPause
	Bsr	PAUSE
.NoPause	Tst.b	80(A0)	F1: Previous level
	Beq.s	.NoPrev
	Move.w	#-1,TypTouche
	Move.w	NLevel,D0
	Blt.s	.Rien
.RecPr	Dbf	D0,.OkPrev
	Bra.s	.Rien
.OkPrev	Lea	Levels,A1
	Tst.l	4(A1,D0.w*8)
	Bne.s	.RecPr
	Move.w	D0,NLevel	
	Jsr	RestoreMainBox
	Bra	INITS		INITS2
.NoPrev	Tst.b	81(A0)	F2: Next level
	Beq.s	.Rien
	Move.w	#1,TypTouche

	Move.l	MenuPtrOptA0,D0
	Sub.l	#Opt_Arena1,D0
	Lsr.w	#2,D0		N° Mode (0=random,seq,one,dyna)
	Bne.s	.Normal
	* Random
	Bra	INITS

.Normal	Move.w	NLevel,D0
	Blt.s	.Rien
.RecNex	Addq.w	#1,D0
	Lea	(Levels,D0.w*8),A1
	Tst.l	(A1)
	Beq.s	.Rien
	Tst.l	4(A1)
	Bne.s	.RecNex
	Move.w	D0,NLevel
	Jsr	RestoreMainBox
	Bra	INITS		INITS2
.Rien	
	Clr.w	Volume_Modif
	IFNE	Music_Activation
	 Tst.b	74(A0)		- (volume music -)
	 Beq.s	.NoVMoins
	 Move.w	WaitVol,D0
	 Dbf	D0,.OkMvo
	 Move.w	#2,D0
.OkMvo	 Move.w	D0,WaitVol
	 Bne.s	.NoVMoins
	 Move.w	#-1,Volume_Modif	
	 Move.w	P61_Master,D0
	 Beq.s	.NoVMoins
	 Subq.w	#1,D0
	 Move.w	D0,P61_Master
	 Move.w	D0,MusicVol
	ENDC
.NoVMoins	
	IFNE	Music_Activation
	 Tst.b	94(A0)		+ (volume music +)
	 Beq.s	.NoVPlus
	 Move.w	WaitVol,D0
	 Dbf	D0,.OkPvo
	 Move.w	#2,D0
.OkPvo	 Move.w	D0,WaitVol
	 Bne.s	.NoVPlus
	 Move.w	#-1,Volume_Modif	
	 Move.w	P61_Master,D0
	 Cmp.w	#64,D0
	 Beq.s	.NoVPlus
	 Addq.w	#1,D0
	 Move.w	D0,P61_Master		
	 Move.w	D0,MusicVol
	ENDC
.NoVPlus	
	IFNE	Music_Activation
	 Tst.b	92(A0)		/ (volume sound -)
	 Beq.s	.NoVMoinsS
	 Move.w	WaitVol2,D0
	 Dbf	D0,.OkMvoS
	 Move.w	#2,D0
.OkMvoS	 Move.w	D0,WaitVol2
	 Bne.s	.NoVMoinsS
	 Move.w	#-1,Volume_Modif	
	 Move.w	SoundVol,D0
	 Beq.s	.NoVMoins
	 Subq.w	#1,D0
	 Move.w	D0,SoundVol
	 Move.w	D0,SoundVolGen
 	ENDC
.NoVMoinsS	
	IFNE	Music_Activation
	 Tst.b	93(A0)		* (volume sound +)
	 Beq.s	.NoVPlusS
	 Move.w	WaitVol2,D0
	 Dbf	D0,.OkPvoS
	 Move.w	#2,D0
.OkPvoS	 Move.w	D0,WaitVol2
	 Bne.s	.NoVPlusS
	 Move.w	#-1,Volume_Modif	
	 Move.w	SoundVol,D0
	 Cmp.w	#64,D0
	 Beq.s	.NoVPlusS
	 Addq.w	#1,D0
	 Move.w	D0,SoundVol
	 Move.w	D0,SoundVolGen
	ENDC
.NoVPlusS



	Tst.w	Volume_Modif
	Beq.s	.NoVChange
	Bsr	BAffVols
	Clr.w	Volume_Modif

.NoVChange
	Tst.b	33(A0)
	Beq.s	.NoSlow
	Moveq	#5,D0
	Sub.w	WaitHardTime,D0
	Move.w	D0,WaitHardTime
.WhileS	Tst.b	33(A0)
	Bne.s	.WhileS
.NoSlow
	IFNE	Music_Activation
	 Moveq	#1,D0	Musique 1
	 Tst.b	82(A0)
	 Bne.s	.Zik		
	 Moveq	#2,D0	Musique 2
	 Tst.b	83(A0)
	 Bne.s	.Zik	
	 Moveq	#3,D0	Musique 3
	 Tst.b	84(A0)
	 Bne.s	.Zik
	 Moveq	#4,D0	Musique 4
	 Tst.b	85(A0)
	 Bne.s	.Zik
	 Moveq	#5,D0	Musique 5
	 Tst.b	86(A0)
	 Bne.s	.Zik	
	 Moveq	#6,D0	Musique 6
	 Tst.b	87(A0)
	 Bne.s	.Zik	
	 Moveq	#7,D0	Musique 7
	 Tst.b	88(A0)
	 Bne.s	.Zik	
	 Moveq	#0,D0	Musique 0 (Off)
	 Tst.b	89(A0)
	 Bne.s	.Zik	
	 Bra	.NoZik2
.Zik	 Cmp.w	MusicInProgress,D0
	 Beq	.NoZik2		Musique déjà en cours
	 Move.w	D0,MemZikCh
	 Jsr	LaunchZik
	 Move.w	MemZik,ActualZik
	*****************

	Bsr	BAffNomMusique

.NoZik2
.NoBarreSwap
	ENDC



.NoTouche
	**** Appels de Gestion

*	Move.w	#$0,$dff180
	
	Bsr	Gestion

	IFNE	DoubleBuffer_Activation
	 Bsr	DoubleBuff
	ENDC

	IFNE	WaitHard_Activation	 
	 Move.w	WaitHardTime,D0
	 Beq.s	.NoWaitH
.OuaHT	 VblWait	#200
	 VblWait	#220
	 Dbf	D0,.OuaHT
.NoWaitH	 *Waithard #WaitHArd_Activation
	ENDC

	**** Bouclage

	*RTest
	*Bne	Main
	
	Bra	Main

.Quit

