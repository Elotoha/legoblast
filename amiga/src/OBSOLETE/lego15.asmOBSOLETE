	Moveq	#1,D6	1 chiffre		"1"
	Move.b	#'0',D7
	Bsr	STR	* Ne modifie pas : D0-D2/A0-A1/A3-A7
.Cop18	Move.b	(A2)+,D2
	Beq.s	.EndC18
	Move.b	D2,(A3)+
	Bra.s	.Cop18
